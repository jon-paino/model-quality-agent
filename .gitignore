# Local-only files (kept on disk but not committed) — mirrors paypal-demo
CLAUDE.md
reference-OPs/
docs/
chat-context/

# Java / Maven build output. The deployable .scm is rebuilt from source against a
# local $STRIIM_HOME (see README); it is NOT committed here (ModelOp.scm is ~41 MB).
target/
*.scm
*.jar

# Regenerable ONNX swap-test artifacts (emitted by make_swap_artifacts.py)
striim/model-op/test/artifacts/

# Regenerable FCVAE swap-test artifacts (make_bad_models.py)
striim/fcvae-scorer/test/artifacts/
# NOTE: striim/pipeline/feeds/ is COMMITTED. The feed source CSV is external (the
# sibling fcvae-anomaly-detection repo, ~496 MB) so a clone cannot regenerate feeds
# with make_fcvae_feed.py; the sliced feeds ship here instead. Do not re-ignore.

# Compiled JVM load-test classes (run_load_test.sh rebuilds them)
striim/fcvae-scorer/test/classes/

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# uv
.uv-cache/

# Feast generated state (regenerated by `feast apply` + the writer)
python/model/feature_repo/data/
python/fcvae/feature_repo/data/*
# ...but keep the FCVAE scoring-params SEED (source data, not Feast-generated)
!python/fcvae/feature_repo/data/params_seed.parquet

# Regenerable FCVAE training/export outputs, EXCEPT the deployable prebuilt ONNX
# bundles (model.onnx + model_config.json + golden_windows.jsonl + model.manifest.json).
# Those are committed so a fresh clone can stage /opt/Striim/fcvae-models without the
# external sibling repo. The torch-side .pt/.pkl training dirs stay out (retrain regenerates them).
python/fcvae/artifacts/*
!python/fcvae/artifacts/Penny_All_prebuilt/
!python/fcvae/artifacts/Accel_CMP_prebuilt/



# IDE / OS
.vscode/
.idea/
.DS_Store

# Logs
*.log

# Retrain trigger runtime artifacts (state, lock, audit log)
striim/retrain/state/
striim/fcvae-params-op/test/classes/
