# MySQL 8.0 config for the Striim CDC source (Quality Agent Layer 2).
# Binlog must be ROW with FULL images so the MySQLReader CDC source sees full
# before/after row images. NOTE: Striim 5.2.0.4's MysqlReader REJECTS
# binlog_row_metadata = FULL ("binlog_row_metadata should not be FULL") and
# requires MINIMAL (the MySQL default). Striim reconstructs column names/types
# from its own JDBC schema tracking (Connector/J) and its schema-evolution
# capture, not from binlog row metadata, so MINIMAL is correct and DDL capture
# is unaffected.
[mysqld]
server-id              = 223344
log_bin                = /var/lib/mysql/mysql-bin
binlog_format          = ROW
binlog_row_image       = FULL
binlog_row_metadata    = MINIMAL
# Allow LOAD DATA LOCAL INFILE so the loader can bulk-ingest the trips CSV.
local_infile           = 1
