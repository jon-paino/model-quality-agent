<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-4_0_0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.striim.demo</groupId>
    <artifactId>ModelOp</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>jar</packaging>
    <name>ModelOp</name>
    <description>Striim Open Processor: ONNX Runtime scoring of the fare model</description>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.source>11</maven.compiler.source>
        <maven.compiler.target>11</maven.compiler.target>
        <!-- Striim install. Override with -DSTRIIM_HOME=... if not at /opt/Striim. -->
        <STRIIM_HOME>/opt/Striim</STRIIM_HOME>
        <STRIIM_VERSION>5.2.0.4</STRIIM_VERSION>
        <!-- Matches the onnxruntime version that exported model.onnx. -->
        <onnxruntime.version>1.26.0</onnxruntime.version>
    </properties>

    <dependencies>
        <!-- Striim jars are system-scoped: resolved straight from the install,
             never downloaded, never bundled into the .scm. -->
        <dependency>
            <groupId>com.striim</groupId>
            <artifactId>OpenProcessorSDK</artifactId>
            <version>1.0.0-SNAPSHOT</version>
            <scope>system</scope>
            <systemPath>${STRIIM_HOME}/StriimSDK/StriimOpenProcessor-SDK.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>com.webaction</groupId>
            <artifactId>Platform</artifactId>
            <version>${STRIIM_VERSION}</version>
            <scope>system</scope>
            <systemPath>${STRIIM_HOME}/lib/Platform-${STRIIM_VERSION}.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>com.webaction</groupId>
            <artifactId>Common</artifactId>
            <version>${STRIIM_VERSION}</version>
            <scope>system</scope>
            <systemPath>${STRIIM_HOME}/lib/Common-${STRIIM_VERSION}.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>com.webaction</groupId>
            <artifactId>SourceCommons</artifactId>
            <version>${STRIIM_VERSION}</version>
            <scope>system</scope>
            <systemPath>${STRIIM_HOME}/lib/SourceCommons-${STRIIM_VERSION}.jar</systemPath>
        </dependency>

        <!-- ONNX Runtime. compile scope: bundled into the .scm (Striim does
             not provide it). The jar carries the per-platform native libs. -->
        <dependency>
            <groupId>com.microsoft.onnxruntime</groupId>
            <artifactId>onnxruntime</artifactId>
            <version>${onnxruntime.version}</version>
        </dependency>
    </dependencies>

    <build>
        <!-- Produces target/ModelOp.jar; build.sh copies it to ModelOp.scm. -->
        <finalName>ModelOp</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <source>${maven.compiler.source}</source>
                    <target>${maven.compiler.target}</target>
                </configuration>
            </plugin>
            <!-- Shade builds the fat jar (bundling onnxruntime) and writes the
                 Striim manifest entries. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.0</version>
                <configuration>
                    <createDependencyReducedPom>false</createDependencyReducedPom>
                    <transformers>
                        <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                            <manifestEntries>
                                <Striim-Module-Name>ModelOp</Striim-Module-Name>
                                <Striim-Service-Interface>com.webaction.runtime.components.openprocessor.StriimOpenProcessor</Striim-Service-Interface>
                                <Striim-Service-Implementation>com.striim.demo.ModelOp</Striim-Service-Implementation>
                            </manifestEntries>
                        </transformer>
                    </transformers>
                    <artifactSet>
                        <excludes>
                            <exclude>org.slf4j:*</exclude>
                            <exclude>log4j:*</exclude>
                        </excludes>
                    </artifactSet>
                    <!-- Drop module descriptors and jar signatures from the
                         bundled onnxruntime jar; both break a shaded fat jar. -->
                    <filters>
                        <filter>
                            <artifact>*:*</artifact>
                            <excludes>
                                <exclude>module-info.class</exclude>
                                <exclude>META-INF/versions/*/module-info.class</exclude>
                                <exclude>META-INF/*.SF</exclude>
                                <exclude>META-INF/*.DSA</exclude>
                                <exclude>META-INF/*.RSA</exclude>
                            </excludes>
                        </filter>
                    </filters>
                </configuration>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals><goal>shade</goal></goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
